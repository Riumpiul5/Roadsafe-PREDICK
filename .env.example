# ---------- App ----------
APP_NAME=RoadSafe AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=roadsafe
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=roadsafe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://roadsafe:change_me_in_prod@localhost:5432/roadsafe

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=roadsafe-severity
MLFLOW_MODEL_NAME=roadsafe-severity-model

# ---------- Model artifacts ----------
MODEL_DIR=artifacts/model
MODEL_FILENAME=roadsafe_pipeline.joblib
MODEL_VERSION=0.0.0

# ---------- Dataset ----------
DATASET_RAW_DIR=dataset/raw
DATASET_PROCESSED_DIR=dataset/processed